<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.healthcare.ui.AdminDashboardController"
            prefHeight="700" prefWidth="1200">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" spacing="8">
            <Label text="🏥 Admin Panel" styleClass="sidebar-title"/>

            <Button fx:id="btnOverview" text="📊 Overview" styleClass="sidebar-btn" onAction="#showOverview"/>
            <Button fx:id="btnUsers" text="👥 User Management" styleClass="sidebar-btn" onAction="#showUsers"/>
            <Button fx:id="btnAppointments" text="📅 Appointments" styleClass="sidebar-btn" onAction="#showAppointments"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="🚪 Logout" styleClass="sidebar-btn" onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- TOP BAR -->
    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="15">
            <Label fx:id="pageTitle" text="Dashboard Overview" styleClass="topbar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="welcomeLabel" text="Welcome, Admin" styleClass="topbar-welcome"/>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <StackPane fx:id="contentPane" styleClass="content-area">

            <!-- OVERVIEW VIEW -->
            <VBox fx:id="overviewView" spacing="20">
                <HBox spacing="20">
                    <VBox styleClass="stat-card" alignment="CENTER" spacing="5">
                        <Label fx:id="totalUsersLabel" text="0" styleClass="stat-value"/>
                        <Label text="Total Users" styleClass="stat-label"/>
                    </VBox>
                    <VBox styleClass="stat-card" alignment="CENTER" spacing="5">
                        <Label fx:id="totalDoctorsLabel" text="0" styleClass="stat-value"/>
                        <Label text="Doctors" styleClass="stat-label"/>
                    </VBox>
                    <VBox styleClass="stat-card" alignment="CENTER" spacing="5">
                        <Label fx:id="totalPatientsLabel" text="0" styleClass="stat-value"/>
                        <Label text="Patients" styleClass="stat-label"/>
                    </VBox>
                    <VBox styleClass="stat-card" alignment="CENTER" spacing="5">
                        <Label fx:id="totalAppointmentsLabel" text="0" styleClass="stat-value"/>
                        <Label text="Appointments" styleClass="stat-label"/>
                    </VBox>
                </HBox>
                <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
                    <Label text="Welcome to Admin Dashboard" styleClass="card-title"/>
                    <Label text="Use the sidebar to manage users, appointments, and system settings." wrapText="true"/>
                </VBox>
            </VBox>

            <!-- USERS VIEW -->
            <VBox fx:id="usersView" spacing="15" visible="false" managed="false">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="All Users" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="userSearchField" promptText="Search by name..." prefWidth="200"/>
                    <Button text="Search" styleClass="btn-primary" onAction="#searchUsers"/>
                    <Button text="+ Add User" styleClass="btn-success" onAction="#addUserDialog"/>
                </HBox>

                <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colUserId" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="colUsername" text="Username" prefWidth="140"/>
                        <TableColumn fx:id="colFullName" text="Full Name" prefWidth="200"/>
                        <TableColumn fx:id="colEmail" text="Email" prefWidth="220"/>
                        <TableColumn fx:id="colPhone" text="Phone" prefWidth="130"/>
                        <TableColumn fx:id="colRole" text="Role" prefWidth="100"/>
                        <TableColumn fx:id="colActions" text="Actions" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- APPOINTMENTS VIEW -->
            <VBox fx:id="appointmentsView" spacing="15" visible="false" managed="false">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="All Appointments" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="apptFilterCombo" prefWidth="150"/>
                    <Button text="Refresh" styleClass="btn-primary" onAction="#loadAppointments"/>
                </HBox>

                <TableView fx:id="appointmentsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colApptId" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="colApptPatient" text="Patient" prefWidth="180"/>
                        <TableColumn fx:id="colApptDoctor" text="Doctor" prefWidth="180"/>
                        <TableColumn fx:id="colApptDate" text="Date &amp; Time" prefWidth="180"/>
                        <TableColumn fx:id="colApptReason" text="Reason" prefWidth="180"/>
                        <TableColumn fx:id="colApptStatus" text="Status" prefWidth="110"/>
                        <TableColumn fx:id="colApptActions" text="Actions" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>

        </StackPane>
    </center>
</BorderPane>