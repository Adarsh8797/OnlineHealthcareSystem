<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.healthcare.ui.DoctorDashboardController"
            prefHeight="700" prefWidth="1200">

    <left>
        <VBox styleClass="sidebar" spacing="8">
            <Label text="🩺 Doctor Panel" styleClass="sidebar-title"/>
            <Button fx:id="btnAppointments" text="📅 My Appointments" styleClass="sidebar-btn" onAction="#showAppointments"/>
            <Button fx:id="btnRecords" text="📋 Patient Records" styleClass="sidebar-btn" onAction="#showRecords"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="🚪 Logout" styleClass="sidebar-btn" onAction="#handleLogout"/>
        </VBox>
    </left>

    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="15">
            <Label fx:id="pageTitle" text="My Appointments" styleClass="topbar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="welcomeLabel" text="Welcome, Doctor" styleClass="topbar-welcome"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentPane" styleClass="content-area">

            <VBox fx:id="appointmentsView" spacing="15">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="My Appointments" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="filterCombo" prefWidth="150"/>
                    <Button text="Refresh" styleClass="btn-primary" onAction="#loadAppointments"/>
                </HBox>
                <TableView fx:id="appointmentsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="colPatient" text="Patient" prefWidth="200"/>
                        <TableColumn fx:id="colDate" text="Date &amp; Time" prefWidth="180"/>
                        <TableColumn fx:id="colReason" text="Reason" prefWidth="200"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="110"/>
                        <TableColumn fx:id="colActions" text="Actions" prefWidth="250"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox fx:id="recordsView" spacing="15" visible="false" managed="false">
                <Label text="Patient Records" styleClass="card-title"/>
                <TableView fx:id="patientsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colPId" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="colPName" text="Name" prefWidth="180"/>
                        <TableColumn fx:id="colPEmail" text="Email" prefWidth="200"/>
                        <TableColumn fx:id="colPPhone" text="Phone" prefWidth="130"/>
                        <TableColumn fx:id="colPBlood" text="Blood Group" prefWidth="110"/>
                        <TableColumn fx:id="colPHistory" text="Medical History" prefWidth="300"/>
                    </columns>
                </TableView>
            </VBox>

        </StackPane>
    </center>
</BorderPane>